<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElectroClick</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <h1><a asp-page="/Index">ElectroClick</a></h1>
        <p>Tienda de electrónica</p>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>ElectroClick - Laboratorio de Programación 3</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>